[Unit]
Description=InstaRadar Django web
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=instradar
Group=instradar
WorkingDirectory=/opt/instradar-py/current
EnvironmentFile=/opt/instradar-py/shared/app.env
ExecStart=/opt/instradar-py/venv/bin/gunicorn config.wsgi:application --workers 2 --bind 127.0.0.1:18832 --timeout 90
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/opt/instradar-py/shared

[Install]
WantedBy=multi-user.target
