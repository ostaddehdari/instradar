[Unit]
Description=InstaRadar Celery worker
After=postgresql.service redis-server.service

[Service]
Type=simple
User=instradar
Group=instradar
WorkingDirectory=/opt/instradar-py/current
EnvironmentFile=/opt/instradar-py/shared/app.env
ExecStart=/opt/instradar-py/venv/bin/celery -A config worker --loglevel=INFO --concurrency=1
Restart=always
RestartSec=5
TimeoutStopSec=100
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/opt/instradar-py/shared

[Install]
WantedBy=multi-user.target
